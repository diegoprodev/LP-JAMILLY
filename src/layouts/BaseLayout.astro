---
import { SEO, SITE, LOCATIONS, BOOKING } from '@/config';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SEO.title,
  description = SEO.description,
} = Astro.props;

const canonicalUrl = SITE.canonicalUrl;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HealthAndBeautyBusiness'],
  name: SITE.name,
  description: SEO.description,
  url: canonicalUrl,
  telephone: '+5583993548045',
  image: `${canonicalUrl}/images/og-image.jpg`,
  priceRange: '$$$$',
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: 'R. Sen. Adalberto Ribeiro, 2 - Tibiri',
      addressLocality: 'Santa Rita',
      addressRegion: 'PB',
      postalCode: '58304-500',
      addressCountry: 'BR',
    },
    {
      '@type': 'PostalAddress',
      addressLocality: 'João Pessoa',
      addressRegion: 'PB',
      addressCountry: 'BR',
    },
  ],
  sameAs: [SITE.instagram, SITE.googleReviews],
  hasMap: LOCATIONS[0].mapsUrl,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SEO.keywords} />
    <meta name="author" content={SITE.doctorName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={SEO.ogTitle} />
    <meta property="og:description" content={SEO.ogDescription} />
    <meta property="og:image" content={`${canonicalUrl}/og-image.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dra. Jamilly Karla — Harmonização Facial em João Pessoa e Santa Rita" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SEO.ogTitle} />
    <meta name="twitter:description" content={SEO.ogDescription} />
    <meta name="twitter:image" content={`${canonicalUrl}/og-image.jpg`} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050505" />

    <!-- Preload hero image (LCP crítico) -->
    <link rel="preload" as="image" href="/images/JAMILLY1.webp" fetchpriority="high" />

    <!-- Fonts: preconnect first, then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Cal.com embed — carregado apenas quando BOOKING.calComUsername está configurado -->
    {BOOKING.calComUsername && (
      <script
        type="text/javascript"
        set:html={`
(function(C,A,L){
  let p=function(a,ar){a.q.push(ar);};
  let d=C.document;
  C.Cal=C.Cal||function(){
    let cal=C.Cal;let ar=arguments;
    if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true;}
    if(ar[0]===L){const api=function(){p(api,arguments);};const ns=ar[1];api.q=api.q||[];
    if(typeof ns==="string"){cal.ns[ns]=cal.ns[ns]||api;p(cal.ns[ns],ar);p(cal,["initNamespace",ns]);}else p(cal,ar);return;}
    p(cal,ar);
  };
})(window,"https://app.cal.com/embed/embed.js","init");
Cal("init",{origin:"https://cal.com"});
Cal("ui",{
  "styles":{"branding":{"brandColor":"${BOOKING.calBrandColor}"}},
  "hideEventTypeDetails":false,
  "layout":"month_view"
});
`}
      />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>
    <slot />
  </body>
</html>
