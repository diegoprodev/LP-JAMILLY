---
import BookingButton from '@/components/BookingButton.astro';
---

<section id="hero" data-theme="dark" aria-label="Apresentação da Jamilly Karla">

  <!-- Photo: absolute-positioned right side, blends via gradient -->
  <img
    src="/images/JAMILLY1.webp"
    alt="Jamilly Karla, especialista em harmonização facial em Santa Rita e João Pessoa PB"
    class="hero-photo-bg"
    loading="eager"
    fetchpriority="high"
    width="900"
    height="900"
    aria-hidden="true"
  />

  <!-- Left-side gradient: blends photo into background -->
  <div class="hero-gradient-left" aria-hidden="true"></div>
  <!-- Bottom gradient: grounds the section into the next -->
  <div class="hero-gradient-bottom" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero-inner">

    <!-- Logo centralizada — some ao scroll (navbar logo aparece no lugar) -->
    <div class="hero-logo-wrapper">
      <img
        id="hero-brand-logo"
        src="/images/logo-jamilly.png"
        alt="Jamilly Karla Centro de Estética e Saúde"
        class="hero-brand-logo"
        loading="eager"
        fetchpriority="high"
        width="410"
        height="220"
      />
    </div>

    <div class="hero-content">

      <p class="overline hero-overline animate-on-scroll">Método FullFaceJK®</p>

      <h1 class="hero-title animate-on-scroll stagger-1">
        Harmonização<br />
        <em>facial que</em><br />
        <span class="text-gold-gradient">respeita seu rosto.</span>
      </h1>

      <p class="hero-subtitle animate-on-scroll stagger-2">
        Planejamento facial personalizado para mulheres que buscam
        equilíbrio, leveza e precisão em cada detalhe.
      </p>

      <p class="hero-body animate-on-scroll stagger-3">
        Atendimento individualizado em João Pessoa e Santa Rita,
        com foco em harmonização facial, rejuvenescimento e valorização
        dos traços de cada paciente.
      </p>

      <div class="hero-ctas animate-on-scroll stagger-4">
        <BookingButton
          label="Agendar Avaliação"
          ariaLabel="Agendar avaliação com a Dra. Jamilly Karla"
        />
        <a href="#metodo" class="btn-ghost" aria-label="Conhecer o Método FullFaceJK">
          Conhecer o Método
        </a>
      </div>

      <div class="hero-proof animate-on-scroll stagger-5">
        <span class="stars" aria-label="5 estrelas">★★★★★</span>
        <span class="proof-text">Avaliada no Google · João Pessoa e Santa Rita, PB</span>
      </div>
    </div>
  </div>

  <!-- Decorative JK monogram watermark -->
  <img
    src="/images/logo-design.png"
    class="hero-watermark"
    aria-hidden="true"
    alt=""
    width="480"
    height="480"
    loading="eager"
  />

  <!-- Subtle scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  #hero {
    /* Warm near-black — feels premium, not flat */
    background: radial-gradient(ellipse at 72% 45%, #1c1510 0%, #0b0906 55%, #080604 100%);
    min-height: 100svh;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-top: 76px;
    padding-bottom: 80px;
  }

  /* ── Photo layer ──────────────────────────── */
  .hero-photo-bg {
    display: none;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 56%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
    pointer-events: none;
    user-select: none;
  }

  /* ── JK watermark ────────────────────────── */
  .hero-watermark {
    position: absolute;
    top: 50%;
    right: -30px;
    transform: translateY(-50%);
    width: 540px;
    height: 540px;
    object-fit: contain;
    opacity: 0.09;
    /* brightness(0)+invert(1) = white silhouette; sepia+saturate = warm gold tint */
    filter: brightness(0) invert(1) sepia(0.9) saturate(3) hue-rotate(6deg) brightness(1.05);
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  /* ── Gradient overlays ────────────────────── */
  .hero-gradient-left {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62%;
    /* Strong fade on left, transparent on right — makes photo "emerge" from bg */
    background: linear-gradient(
      to right,
      #0b0906 0%,
      rgba(11, 9, 6, 0.92) 18%,
      rgba(11, 9, 6, 0.6) 38%,
      rgba(11, 9, 6, 0.15) 62%,
      rgba(11, 9, 6, 0) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-gradient-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 220px;
    background: linear-gradient(to bottom, transparent, #0b0906);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Content ──────────────────────────────── */
  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 560px;
  }

  /* Wrapper para o shimmer da logo */
  .hero-logo-wrapper {
    display: block;
    position: relative;
    width: fit-content;
    /* Alinhado à esquerda, junto ao conteúdo */
    margin: 0 0 40px;
    z-index: 2;
  }

  /* Shimmer mascarado pela própria PNG da logo — só aparece nos pixels da arte */
  .hero-logo-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 25%,
      rgba(255, 248, 200, 0.85) 50%,
      transparent 75%
    );
    background-size: 300% 100%;
    background-position: -100% 0;
    /* Máscara = shape exato da logo PNG */
    -webkit-mask-image: url('/images/logo-jamilly.png');
    mask-image: url('/images/logo-jamilly.png');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: logo-shimmer 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes logo-shimmer {
    0%, 30% { background-position: -100% 0; }
    70%, 100% { background-position: 200% 0; }
  }

  /* Logo — esquerda, alinhada ao hero-content */
  .hero-brand-logo {
    display: block;
    height: 220px;
    width: auto;
    position: relative;
    z-index: 1;
  }

  .hero-overline {
    color: #b08a3c;
    margin-bottom: 20px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0 0 28px;
  }

  .hero-title em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.68);
    margin: 0 0 14px;
  }

  .hero-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.38);
    margin: 0 0 40px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .hero-proof {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stars {
    font-size: 0.875rem;
    letter-spacing: 2px;
    color: #b08a3c;
  }

  .proof-text {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    font-family: var(--font-body);
    letter-spacing: 0.04em;
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, #b08a3c, transparent);
    animation: scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.7; }
  }

  /* ── Desktop (≥ 900px) ───────────────────── */
  @media (min-width: 900px) {
    .hero-photo-bg {
      display: block;
    }

    .hero-gradient-left {
      display: block;
    }

    .hero-ctas {
      flex-wrap: nowrap;
    }
  }

  /* ── Tablet (600–899px) ───────────────────── */
  @media (min-width: 600px) and (max-width: 899px) {
    #hero {
      padding-top: 76px;
      padding-bottom: 80px;
    }

    /* Foto lado direito — object-position mostra Jamilly (28-42% da imagem) */
    .hero-photo-bg {
      display: block;
      width: 65%;
      object-position: 20% 12%;
    }

    .hero-gradient-left {
      display: block;
      width: 100%;
      background: linear-gradient(
        to right,
        #0b0906 0%,
        rgba(11,9,6,0.97) 24%,
        rgba(11,9,6,0.80) 44%,
        rgba(11,9,6,0.38) 60%,
        rgba(11,9,6,0.08) 72%,
        transparent 80%
      );
    }

    .hero-brand-logo {
      height: 160px;
    }

    .hero-logo-wrapper {
      margin-bottom: 32px;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-ctas {
      flex-wrap: nowrap;
    }
  }

  /* ── Mobile (< 600px) ────────────────────── */
  @media (max-width: 599px) {
    #hero {
      padding-top: 68px;
      padding-bottom: 64px;
    }

    /* Foto lado direito — 20% mostra Jamilly em 56-87% da tela */
    .hero-photo-bg {
      display: block;
      width: 72%;
      right: -16px;
      object-position: 20% 15%;
      opacity: 0.90;
    }

    /* Gradiente full-width: escuro esquerda → transparente onde Jamilly aparece */
    .hero-gradient-left {
      display: block;
      width: 100%;
      background: linear-gradient(
        to right,
        #0b0906 0%,
        rgba(11,9,6,0.97) 26%,
        rgba(11,9,6,0.82) 48%,
        rgba(11,9,6,0.42) 62%,
        rgba(11,9,6,0.12) 74%,
        rgba(11,9,6,0.02) 83%,
        transparent 90%
      );
    }

    .hero-inner {
      padding: 0 16px;
    }

    .hero-brand-logo {
      height: 140px;
    }

    .hero-logo-wrapper {
      margin-bottom: 28px;
    }

    .hero-content {
      max-width: 100%;
    }

    /* Sombra sutil no título para legibilidade sobre a foto */
    .hero-title {
      text-shadow: 0 2px 16px rgba(0,0,0,0.45);
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas a {
      width: 100%;
      text-align: center;
    }

    .hero-watermark {
      width: 300px;
      height: 300px;
      right: -60px;
    }
  }
</style>
