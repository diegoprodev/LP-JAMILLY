---
import { PROCEDURES } from '@/config';

// Unique SVG icons for each procedure (line art, 28x28, stroke only)
const icons = [
  // Harmonização Facial - face with lines
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M9 8h.01M15 8h.01"/><path d="M9.5 11.5s.5 1.5 2.5 1.5 2.5-1.5 2.5-1.5"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg>`,
  // Toxina Botulínica - syringe
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 2 4 4"/><path d="m17 7 1-1"/><path d="M3 22 7 18"/><path d="M7 18l2-2"/><path d="M9 16l-3-3 9-9 3 3-9 9z"/><path d="m9 16 1 1"/><path d="M13 7l-2 2"/></svg>`,
  // Preenchimento Labial - lips
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14c0 2.2 4 5 9 5s9-2.8 9-5c0-1-1-2-3-2-1.5 0-2.5.5-3 1-.5.5-1.5.5-2 0-.5-.5-1.5-1-3-1-2 0-3 1-3 2z"/><path d="M3 14c0-1 .5-2 1.5-2.5C5.5 11 7 11 8 11.5c.7.3 1.3.5 2 .5h4c.7 0 1.3-.2 2-.5C17 11 18.5 11 19.5 11.5c1 .5 1.5 1.5 1.5 2.5"/><path d="M12 12v2"/></svg>`,
  // Bioestimuladores - cell/molecule
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><path d="M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg>`,
  // Rinomodelação - nose outline
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c0 0-3 4-3 8 0 2.5 1 4 3 4s3-1.5 3-4c0-4-3-8-3-8z"/><path d="M9 19c-1.5 0-3 .5-3 1.5S7.5 22 12 22s6.5-.5 6.5-1.5S16.5 19 15 19"/></svg>`,
  // Skinbooster - water drop
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c0 0-8 7-8 12a8 8 0 0 0 16 0c0-5-8-12-8-12z"/><path d="M8 16a4 4 0 0 0 4 4"/></svg>`,
  // Contorno Facial - face contour
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6C5 4 7 2 12 2s7 2 7 4v6c0 4-3 8-7 10C8 20 5 16 5 12V6z"/><path d="M9 9h.01M15 9h.01"/><path d="M9.5 14s.5 2 2.5 2 2.5-2 2.5-2"/></svg>`,
  // Rejuvenescimento - sparkle/star
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/><circle cx="12" cy="12" r="3"/></svg>`,
];
---

<section id="procedimentos" data-theme="dark" aria-label="Procedimentos realizados pela Dra. Jamilly Karla">
  <div class="procedimentos-inner">
    <div class="procedimentos-header">
      <p class="overline animate-on-scroll" style="color: rgba(176,138,60,0.9)">Especialidades</p>
      <h2 class="heading-display procedimentos-title animate-on-scroll stagger-1">
        Procedimentos realizados
      </h2>
      <p class="cfm-disclaimer animate-on-scroll stagger-2">
        A indicação de cada procedimento depende de avaliação profissional individual.
      </p>
    </div>

    <div class="procedures-grid" role="list" aria-label="Lista de procedimentos">
      {PROCEDURES.map((proc, index) => (
        <div
          class={`procedure-card animate-on-scroll stagger-${(index % 4) + 1}`}
          role="listitem"
        >
          <div class="procedure-icon" aria-hidden="true" set:html={icons[index]} />
          <h3 class="procedure-name">{proc.name}</h3>
          <p class="procedure-desc">{proc.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #procedimentos {
    background: #050505;
    padding: 100px 0;
  }

  .procedimentos-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .procedimentos-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 64px;
  }

  .procedimentos-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #ffffff;
    margin: 12px 0 16px;
  }

  .cfm-disclaimer {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.02em;
    line-height: 1.6;
    margin: 0;
  }

  .procedures-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(176, 138, 60, 0.12);
  }

  .procedure-card {
    background: #050505;
    padding: 36px 32px;
    transition: background 0.25s ease;
    position: relative;
  }

  .procedure-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(176, 138, 60, 0.12);
  }

  .procedure-card:hover {
    background: #0e0e0e;
  }

  .procedure-icon {
    margin-bottom: 16px;
    opacity: 0.85;
  }

  .procedure-name {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .procedure-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  @media (min-width: 600px) {
    .procedures-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .procedures-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 599px) {
    #procedimentos {
      padding: 64px 0;
    }

    .procedimentos-header {
      margin-bottom: 48px;
    }

    .procedure-card {
      padding: 28px 20px;
    }
  }
</style>
