---
import { SITE } from '@/config';

const resultImages = [
  { src: '/images/CLIENTE1.webp', label: 'Resultado 1' },
  { src: '/images/CLIENTE2.webp', label: 'Resultado 2' },
  { src: '/images/CLIENTE3.1.webp', label: 'Resultado 3' },
  { src: '/images/CLIENTE3-2.webp', label: 'Resultado 4' },
];
---

<section id="resultados" aria-label="Resultados de pacientes da Dra. Jamilly Karla">
  <div class="resultados-inner">
    <div class="resultados-header">
      <p class="overline animate-on-scroll">Transformações</p>
      <h2 class="heading-display resultados-title animate-on-scroll stagger-1">
        Resultados com presença,<br />
        <em>proporção e identidade.</em>
      </h2>
      <p class="resultados-text animate-on-scroll stagger-2">
        O objetivo é que o resultado seja percebido pela harmonia do rosto,
        não pela evidência do procedimento.
      </p>
      <p class="cfm-disclaimer animate-on-scroll stagger-3">
        Os resultados apresentados são individuais e podem variar. Imagens utilizadas
        com autorização expressa dos pacientes, conforme Resolução CFM 2336/2023.
      </p>
    </div>

    <div class="resultados-grid" aria-label="Galeria de resultados">
      {resultImages.map((img, index) => (
        <div class={`resultado-item animate-on-scroll stagger-${index + 1}`}>
          <img
            src={img.src}
            alt={`${img.label} de harmonização facial pela Dra. Jamilly Karla em Santa Rita e João Pessoa`}
            class="resultado-photo"
            loading="lazy"
            width="400"
            height="533"
            onerror="this.parentElement.classList.add('placeholder-active')"
          />
          <div class="resultado-placeholder" aria-hidden="true">
            <span class="placeholder-text">{img.label}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="resultados-cta animate-on-scroll">
      <a
        href={SITE.googleReviews}
        class="btn-gold-outline"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver avaliações de pacientes no Google (abre em nova aba)"
      >
        Ver avaliações no Google
      </a>
    </div>
  </div>
</section>

<style>
  #resultados {
    background: #f7f2ea;
    padding: 100px 0;
  }

  .resultados-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .resultados-header {
    max-width: 640px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .resultados-title {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    color: #050505;
    margin: 12px 0 20px;
  }

  .resultados-title em {
    font-style: italic;
    color: #6b6b6b;
  }

  .resultados-text {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: #6b6b6b;
    margin: 0 0 16px;
  }

  .cfm-disclaimer {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #a09080;
    line-height: 1.6;
    margin: 0;
  }

  /* Results grid */
  .resultados-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 56px;
  }

  .resultado-item {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #e8e0d0;
  }

  .resultado-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .resultado-item:hover .resultado-photo {
    transform: scale(1.03);
  }

  .resultado-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e0d0;
    opacity: 0;
    pointer-events: none;
  }

  /* Show placeholder when image fails */
  .resultado-item.placeholder-active .resultado-placeholder {
    opacity: 1;
  }
  .resultado-item.placeholder-active .resultado-photo {
    opacity: 0;
  }

  .placeholder-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #a09080;
  }

  .resultados-cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .resultados-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 599px) {
    #resultados {
      padding: 64px 0;
    }

    .resultados-header {
      margin-bottom: 48px;
    }

    .resultados-grid {
      gap: 8px;
    }
  }
</style>
