---
import { SITE } from '@/config';

const resultImages = [
  { src: '/images/CLIENTE1.webp', label: 'Resultado 1' },
  { src: '/images/CLIENTE2.webp', label: 'Resultado 2' },
  { src: '/images/CLIENTE3.1.webp', label: 'Resultado 3' },
  { src: '/images/CLIENTE3-2.webp', label: 'Resultado 4' },
];
---

<section id="resultados" aria-label="Resultados de pacientes da Dra. Jamilly Karla">
  <div class="resultados-inner">
    <div class="resultados-header">
      <p class="overline animate-on-scroll">Resultados</p>
      <h2 class="heading-display resultados-title animate-on-scroll stagger-1">
        Resultados com presença,<br />
        <em>proporção e identidade.</em>
      </h2>
      <p class="resultados-text animate-on-scroll stagger-2">
        O objetivo é que o resultado seja percebido pela harmonia do rosto,
        não pela evidência do procedimento.
      </p>
      <p class="cfm-disclaimer animate-on-scroll stagger-3">
        Os resultados apresentados são individuais e podem variar. Imagens utilizadas
        com autorização expressa dos pacientes, conforme Resolução CFM 2336/2023.
      </p>
    </div>

    <!-- Carousel -->
    <div class="carousel animate-on-scroll stagger-2" role="region" aria-label="Galeria de resultados">
      <div class="carousel-track">
        {resultImages.map((img, index) => (
          <div
            class={`slide${index === 0 ? ' active' : ''}`}
            aria-hidden={index !== 0 ? 'true' : 'false'}
            data-index={index}
          >
            <img
              src={img.src}
              alt={`${img.label} de harmonização facial pela Dra. Jamilly Karla em Santa Rita e João Pessoa`}
              class="slide-img"
              loading={index === 0 ? 'eager' : 'lazy'}
              width="440"
              height="587"
              onerror="this.parentElement.classList.add('placeholder-active')"
            />
            <div class="slide-placeholder" aria-hidden="true">
              <span class="placeholder-text">{img.label}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Dot indicators -->
      <div class="carousel-dots" role="tablist" aria-label="Navegar entre resultados">
        {resultImages.map((_, index) => (
          <button
            class={`dot${index === 0 ? ' active' : ''}`}
            role="tab"
            aria-label={`Ver resultado ${index + 1}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            data-dot={index}
          />
        ))}
      </div>
    </div>

    <div class="resultados-cta animate-on-scroll">
      <a
        href={SITE.googleReviews}
        class="btn-gold-outline"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver avaliações de pacientes no Google (abre em nova aba)"
      >
        Ver avaliações no Google
      </a>
    </div>
  </div>
</section>

<style>
  #resultados {
    background: #f7f2ea;
    padding: 120px 0;
  }

  .resultados-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .resultados-header {
    max-width: 640px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .resultados-title {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    color: #050505;
    margin: 12px 0 20px;
  }

  .resultados-title em {
    font-style: italic;
    color: #6b6b6b;
  }

  .resultados-text {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: #6b6b6b;
    margin: 0 0 16px;
  }

  .cfm-disclaimer {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #a09080;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Carousel ─────────────────────────────── */
  .carousel {
    margin-bottom: 56px;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 3 / 4;
    margin: 0 auto;
    overflow: hidden;
    background: #e8e0d0;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.85s ease;
    pointer-events: none;
  }

  .slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slide-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e0d0;
    opacity: 0;
    pointer-events: none;
  }

  .slide.placeholder-active .slide-placeholder {
    opacity: 1;
  }

  .slide.placeholder-active .slide-img {
    opacity: 0;
  }

  .placeholder-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #a09080;
  }

  /* ── Dots ─────────────────────────────────── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(176, 138, 60, 0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background: #b08a3c;
    transform: scale(1.4);
  }

  .dot:focus-visible {
    outline: 2px solid #b08a3c;
    outline-offset: 3px;
  }

  /* ── CTA ──────────────────────────────────── */
  .resultados-cta {
    text-align: center;
  }

  /* ── Tablet (600–899px) ───────────────────── */
  @media (min-width: 600px) {
    .carousel-track {
      max-width: 480px;
    }
  }

  @media (min-width: 768px) {
    .carousel-track {
      max-width: 520px;
    }
  }

  /* ── Mobile (< 600px) ────────────────────── */
  @media (max-width: 599px) {
    #resultados {
      padding: 64px 0;
    }

    .resultados-inner {
      padding: 0 16px;
    }

    .resultados-header {
      margin-bottom: 40px;
    }

    .carousel-track {
      max-width: 100%;
    }

    .dot {
      width: 8px;
      height: 8px;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('#resultados .slide');
  const dots = document.querySelectorAll<HTMLButtonElement>('#resultados .dot');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('active');
    dots[current].setAttribute('aria-selected', 'false');

    current = index;

    slides[current].classList.add('active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % slides.length), 4000);
  }

  function stopTimer() {
    clearInterval(timer);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      stopTimer();
      goTo(i);
      startTimer();
    });
  });

  const track = document.querySelector('#resultados .carousel-track');
  track?.addEventListener('mouseenter', stopTimer);
  track?.addEventListener('mouseleave', startTimer);

  startTimer();
</script>
