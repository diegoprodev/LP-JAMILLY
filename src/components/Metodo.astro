---
import { METHOD_STEPS, WHATSAPP_URL } from '@/config';
---

<section id="metodo" aria-label="O Método FullFaceJK">
  <div class="metodo-inner">
    <div class="metodo-header">
      <p class="overline animate-on-scroll">Nosso diferencial</p>
      <h2 class="heading-display metodo-title animate-on-scroll stagger-1">
        O Método FullFaceJK®
      </h2>
      <p class="metodo-subtitle animate-on-scroll stagger-2">
        O FullFaceJK® organiza a harmonização facial como um plano,
        não como uma soma de procedimentos isolados.
      </p>
    </div>

    <div class="steps" role="list" aria-label="Etapas do Método FullFaceJK">
      {METHOD_STEPS.map((step, index) => (
        <div class={`step animate-on-scroll stagger-${index + 1}`} role="listitem">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <div class="step-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="metodo-cta animate-on-scroll">
      <a
        href={WHATSAPP_URL}
        class="btn-primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Agendar avaliação com o Método FullFaceJK pelo WhatsApp"
      >
        Agendar minha avaliação
      </a>
    </div>
  </div>
</section>

<style>
  #metodo {
    background: #ffffff;
    padding: 100px 0;
  }

  .metodo-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .metodo-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 72px;
  }

  .metodo-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #050505;
    margin: 12px 0 20px;
  }

  .metodo-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #6b6b6b;
    margin: 0;
  }

  /* Steps grid */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 64px;
  }

  .step {
    display: flex;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid rgba(5, 5, 5, 0.06);
    position: relative;
  }

  .step:last-child {
    border-bottom: none;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 300;
    line-height: 1;
    color: #f7f2ea;
    min-width: 80px;
    text-align: right;
    flex-shrink: 0;
    user-select: none;
  }

  .step-body {
    padding-top: 8px;
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    color: #050505;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #6b6b6b;
    margin: 0;
    max-width: 560px;
  }

  .metodo-cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 0 48px;
    }

    .step {
      border-bottom: 1px solid rgba(5, 5, 5, 0.06);
    }

    /* Remove border from last row */
    .step:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  @media (max-width: 599px) {
    #metodo {
      padding: 64px 0;
    }

    .metodo-header {
      margin-bottom: 48px;
    }

    .step-number {
      font-size: 3.5rem;
      min-width: 56px;
    }
  }
</style>
