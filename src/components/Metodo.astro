---
import { METHOD_STEPS } from '@/config';
import BookingButton from '@/components/BookingButton.astro';
---

<section id="metodo" aria-label="O Método FullFaceJK">
  <div class="metodo-inner">
    <div class="metodo-header">
      <p class="overline animate-on-scroll">Por que existe um método</p>
      <h2 class="heading-display metodo-title animate-on-scroll stagger-1">
        O Método FullFaceJK®
      </h2>
      <p class="metodo-subtitle animate-on-scroll stagger-2">
        A maioria das pessoas que chega à primeira consulta já sabe o que quer fazer.
        O FullFaceJK® começa por questionar se é mesmo isso que precisa ser feito.
      </p>
    </div>

    <div class="steps" role="list" aria-label="Etapas do Método FullFaceJK">
      {METHOD_STEPS.map((step, index) => (
        <div class={`step animate-on-scroll stagger-${index + 1}`} role="listitem">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <div class="step-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="metodo-cta animate-on-scroll">
      <BookingButton
        label="Agendar minha avaliação"
        ariaLabel="Agendar avaliação com o Método FullFaceJK"
      />
    </div>
  </div>
</section>

<style>
  #metodo {
    background: #ffffff;
    padding: 100px 0;
  }

  .metodo-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .metodo-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 72px;
  }

  .metodo-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 12px 0 20px;
    /* Shimmer dourado suave varrendo o texto */
    background: linear-gradient(90deg, #050505 30%, #c9a55a 50%, #050505 70%);
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: title-shimmer 4.5s ease-in-out infinite;
  }

  @keyframes title-shimmer {
    0%, 100% { background-position: 140% 0; }
    45%, 55% { background-position: -40% 0; }
  }

  .metodo-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #6b6b6b;
    margin: 0;
  }

  /* Steps grid */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 64px;
  }

  .step {
    display: flex;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid rgba(5, 5, 5, 0.06);
    position: relative;
  }

  .step:last-child {
    border-bottom: none;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 300;
    line-height: 1;
    color: rgba(176, 138, 60, 0.08);
    min-width: 80px;
    text-align: right;
    flex-shrink: 0;
    user-select: none;
    transition: color 0.9s ease;
  }

  .step.number-colored .step-number {
    color: #b08a3c;
  }

  .step-body {
    padding-top: 8px;
    flex: 1;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    color: #050505;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #6b6b6b;
    margin: 0;
    max-width: 560px;
  }

  .metodo-cta {
    text-align: center;
  }

  /* ── Tablet and up (≥ 600px) ─────────────── */
  @media (min-width: 600px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 0 48px;
    }

    .step {
      border-bottom: 1px solid rgba(5, 5, 5, 0.06);
    }

    /* Remove border from last row */
    .step:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  /* ── Tablet (600–899px) ───────────────────── */
  @media (min-width: 600px) and (max-width: 899px) {
    #metodo {
      padding: 80px 0;
    }

    .metodo-header {
      margin-bottom: 56px;
    }

    .step {
      gap: 24px;
      padding: 28px 0;
    }

    .step-number {
      font-size: 4rem;
      min-width: 60px;
    }
  }

  /* ── Mobile (< 600px) ────────────────────── */
  @media (max-width: 599px) {
    #metodo {
      padding: 64px 0;
    }

    .metodo-inner {
      padding: 0 16px;
    }

    .metodo-header {
      margin-bottom: 40px;
    }

    .step {
      gap: 20px;
      padding: 28px 0;
    }

    .step-number {
      font-size: 3rem;
      min-width: 48px;
    }

    .step-title {
      font-size: 1.375rem;
    }
  }
</style>

<script>
  const steps = document.querySelectorAll('#metodo .step');
  if (steps.length > 0) {
    const numberObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('number-colored');
          numberObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    steps.forEach(step => numberObserver.observe(step));
  }
</script>
