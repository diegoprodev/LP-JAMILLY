---
import { WHATSAPP_URL } from '@/config';
---

<section id="cta-final" aria-label="Agende sua avaliação com a Dra. Jamilly Karla">
  <div class="cta-inner">
    <p class="overline animate-on-scroll" style="color: rgba(176,138,60,0.9)">Dê o primeiro passo</p>

    <h2 class="heading-display cta-title animate-on-scroll stagger-1">
      Um bom planejamento muda<br />
      <em>a forma como o rosto é percebido.</em>
    </h2>

    <p class="cta-text animate-on-scroll stagger-2">
      Agende uma avaliação e entenda quais procedimentos fazem sentido para o seu rosto.
      Atendemos em João Pessoa e Santa Rita, PB.
    </p>

    <div class="cta-action animate-on-scroll stagger-3">
      <a
        href={WHATSAPP_URL}
        class="btn-primary cta-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Agendar avaliação com a Dra. Jamilly Karla pelo WhatsApp"
      >
        Agendar avaliação
      </a>
      <p class="cta-reassurance">Resposta em até 24 horas · Atendimento personalizado</p>
    </div>
  </div>
</section>

<style>
  #cta-final {
    background: #050505;
    padding: 120px 0;
    border-top: 3px solid #b08a3c;
    text-align: center;
  }

  .cta-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cta-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: #ffffff;
    margin: 16px 0 28px;
  }

  .cta-title em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
  }

  .cta-text {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 48px;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-btn {
    padding: 0 48px;
    min-height: 56px;
    font-size: 0.9375rem;
  }

  .cta-reassurance {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.06em;
    margin: 0;
  }

  @media (max-width: 599px) {
    #cta-final {
      padding: 80px 0;
    }

    .cta-btn {
      width: 100%;
    }
  }
</style>
