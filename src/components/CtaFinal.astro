---
import BookingButton from '@/components/BookingButton.astro';
---

<section id="cta-final" data-theme="dark" aria-label="Agende sua avaliação com a Dra. Jamilly Karla">
  <!-- Decorative JK watermark -->
  <img
    src="/images/logo-design.png"
    class="cta-watermark"
    aria-hidden="true"
    alt=""
    width="400"
    height="400"
    loading="lazy"
  />

  <div class="cta-inner">
    <p class="overline animate-on-scroll" style="color: rgba(176,138,60,0.9)">Comece pelo diagnóstico</p>

    <h2 class="heading-display cta-title animate-on-scroll stagger-1">
      Um bom planejamento muda<br />
      <em>a forma como o rosto é percebido.</em>
    </h2>

    <p class="cta-text animate-on-scroll stagger-2">
      Agende uma avaliação e entenda quais procedimentos fazem sentido para o seu rosto.
      Atendemos em João Pessoa e Santa Rita, PB.
    </p>

    <div class="cta-action animate-on-scroll stagger-3">
      <BookingButton
        class="btn-primary cta-btn"
        label="Agendar avaliação"
        ariaLabel="Agendar avaliação com a Dra. Jamilly Karla"
      />
      <p class="cta-reassurance">Resposta em até 24 horas · Atendimento personalizado</p>
    </div>
  </div>
</section>

<style>
  #cta-final {
    background: #050505;
    padding: 140px 0;
    border-top: 3px solid #b08a3c;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    object-fit: contain;
    opacity: 0.06;
    filter: brightness(0) invert(1);
    pointer-events: none;
    user-select: none;
  }

  .cta-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cta-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: #ffffff;
    margin: 16px 0 28px;
  }

  .cta-title em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
  }

  .cta-text {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 48px;
  }

  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-btn {
    padding: 0 48px;
    min-height: 56px;
    font-size: 0.9375rem;
  }

  .cta-reassurance {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.06em;
    margin: 0;
  }

  /* ── Tablet (600–899px) ───────────────────── */
  @media (min-width: 600px) and (max-width: 899px) {
    #cta-final {
      padding: 96px 0;
    }

    .cta-watermark {
      width: 320px;
      height: 320px;
    }
  }

  /* ── Mobile (< 600px) ────────────────────── */
  @media (max-width: 599px) {
    #cta-final {
      padding: 72px 0;
    }

    .cta-inner {
      padding: 0 16px;
    }

    .cta-watermark {
      width: 260px;
      height: 260px;
    }

    .cta-btn {
      width: 100%;
      padding: 0 24px;
    }

    .cta-title {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
    }

    .cta-text {
      font-size: 1rem;
      margin-bottom: 36px;
    }
  }
</style>
