---
import { SITE, WHATSAPP_URL } from '@/config';
---

<footer role="contentinfo">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="#hero" aria-label="Jamilly Karla — topo da página">
        <img
          src="/images/logo-jamilly.png"
          alt="Jamilly Karla Centro de Estética e Saúde"
          height="56"
          width="auto"
          loading="lazy"
          class="footer-logo"
        />
      </a>
      <p class="footer-tagline">
        Harmonização facial, estética avançada<br />e planejamento facial personalizado.
      </p>
    </div>

    <div class="footer-links">
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
        aria-label="Instagram da Dra. Jamilly Karla (abre em nova aba)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
        Instagram
      </a>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
        aria-label="WhatsApp da Dra. Jamilly Karla (abre em nova aba)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
          <path d="M9 10c0 .5.2 1 .5 1.5.3.4 1 1.2 1 1.2s1 1.5 2.5 2c.8.3 1.5.3 2 0 .3-.2.5-.4.6-.6.1-.3.1-.6 0-.9-.2-.4-1-.8-1.3-1-.4-.2-.7-.2-1 .1-.2.2-.3.4-.3.4"/>
        </svg>
        WhatsApp
      </a>

      <a
        href={SITE.googleReviews}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
        aria-label="Avaliações no Google da Dra. Jamilly Karla (abre em nova aba)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        Avaliações
      </a>
    </div>

    <div class="footer-bottom">
      <p>© 2026 {SITE.name}. Todos os direitos reservados.</p>
      <a href="/politica-de-privacidade" class="footer-privacy">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #050505;
    padding: 64px 0 32px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-brand {
    margin-bottom: 40px;
  }

  .footer-logo {
    height: 56px;
    width: auto;
    filter: brightness(0) invert(1);
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
    letter-spacing: 0.04em;
  }

  .footer-link:hover {
    color: #b08a3c;
  }

  .footer-link:focus-visible {
    outline: 2px solid #b08a3c;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .footer-bottom p {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    font-family: var(--font-body);
  }

  .footer-privacy {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.25);
    text-decoration: none;
    font-family: var(--font-body);
    transition: color 0.2s ease;
  }

  .footer-privacy:hover {
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-privacy:focus-visible {
    outline: 2px solid #b08a3c;
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
