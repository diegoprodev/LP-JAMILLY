---
import { LOCATIONS, WHATSAPP_URL } from '@/config';
---

<section id="localizacao" data-theme="dark" aria-label="Localização dos consultórios da Dra. Jamilly Karla">
  <div class="localizacao-inner">
    <div class="localizacao-header">
      <p class="overline animate-on-scroll" style="color: rgba(176,138,60,0.9)">Presença regional</p>
      <h2 class="heading-display localizacao-title animate-on-scroll stagger-1">
        Atendimento em João Pessoa<br />
        <em>e Santa Rita</em>
      </h2>
    </div>

    <div class="locations-grid">
      {LOCATIONS.map((loc, index) => (
        <div class={`location-card animate-on-scroll stagger-${index + 1}`}>
          <div class="location-top">
            <span class="location-state">PB</span>
            <h3 class="location-city">{loc.city}</h3>
          </div>
          <div class="location-address">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#b08a3c" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <address class="address-text">{loc.address}</address>
          </div>
          <a
            href={loc.mapsUrl}
            class="location-map-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${loc.city} no Google Maps (abre em nova aba)`}
          >
            Ver no Google Maps
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <div class="localizacao-cta animate-on-scroll">
      <a
        href={WHATSAPP_URL}
        class="btn-primary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com a Dra. Jamilly pelo WhatsApp para agendar consulta"
      >
        Falar pelo WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  #localizacao {
    background: #050505;
    padding: 100px 0;
  }

  .localizacao-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .localizacao-header {
    margin-bottom: 64px;
    text-align: center;
  }

  .localizacao-title {
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    color: #ffffff;
    margin: 12px 0 0;
  }

  .localizacao-title em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    margin-bottom: 56px;
    background: rgba(176, 138, 60, 0.15);
  }

  .location-card {
    background: #050505;
    padding: 48px 40px;
    transition: background 0.25s ease;
    border: 1px solid rgba(176, 138, 60, 0.15);
  }

  .location-card:hover {
    background: #0e0e0e;
  }

  .location-top {
    margin-bottom: 20px;
  }

  .location-state {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b08a3c;
    display: block;
    margin-bottom: 8px;
  }

  .location-city {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .location-address {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 28px;
  }

  .location-address svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .address-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.45);
    font-style: normal;
  }

  .location-map-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b08a3c;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .location-map-link:hover {
    opacity: 0.75;
  }

  .location-map-link:focus-visible {
    outline: 2px solid #b08a3c;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .localizacao-cta {
    text-align: center;
  }

  /* ── Tablet and up (≥ 600px) ─────────────── */
  @media (min-width: 600px) {
    .locations-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Tablet (600–899px) ───────────────────── */
  @media (min-width: 600px) and (max-width: 899px) {
    #localizacao {
      padding: 80px 0;
    }

    .localizacao-header {
      margin-bottom: 48px;
    }

    .location-card {
      padding: 36px 28px;
    }
  }

  /* ── Mobile (< 600px) ────────────────────── */
  @media (max-width: 599px) {
    #localizacao {
      padding: 64px 0;
    }

    .localizacao-inner {
      padding: 0 16px;
    }

    .localizacao-header {
      margin-bottom: 40px;
    }

    .location-card {
      padding: 28px 20px;
    }
  }
</style>
