---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Autoridade from '@/components/Autoridade.astro';
import Metodo from '@/components/Metodo.astro';
import ProceduresCarousel from '@/components/ProceduresCarousel.jsx';
import Resultados from '@/components/Resultados.astro';
import Depoimentos from '@/components/Depoimentos.astro';
import FAQ from '@/components/FAQ.astro';
import Localizacao from '@/components/Localizacao.astro';
import CtaFinal from '@/components/CtaFinal.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import ScrollAnimations from '@/components/ScrollAnimations.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <Autoridade />
    <Metodo />
    <ProceduresCarousel client:visible />
    <Resultados />
    <Depoimentos />
    <FAQ />
    <Localizacao />
    <CtaFinal />
  </main>
  <Footer />
  <WhatsAppButton />
  <CookieBanner />
  <ScrollAnimations />
</BaseLayout>
